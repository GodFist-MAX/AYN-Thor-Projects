KEY_RE = re.compile(r"^xai-[A-Za-z0-9_-]{20,300}$")
BRAIN_MODELS = {"smartest": "grok-4.7", "fastest": "grok-4.20-0309-non-reasoning"}


def brain_line(m):
    who = {"user": "You", "me": "Coronamon", "error": "Problem"}.get(m.get("role"), m.get("role", "?"))
    meta = [time.strftime("%H:%M", time.localtime(m.get("t", 0) / 1000))]
    if m.get("ms"):
        meta.append("%.1fs" % (m["ms"] / 1000.0))
    if m.get("cost"):
        meta.append("$%.4f" % m["cost"])
    print("%s [%s]: %s" % (who, ", ".join(meta), m.get("text", "")))
    for a in m.get("actions") or []:
        hint = "   coro brain yes|no %s:%s" % (m.get("id"), a.get("id")) if a.get("state") == "asked" else ""
        print("    button: %s (%s)%s" % (a.get("label"), a.get("state"), hint))


def read_key(path):
    if path:
        with open(os.path.expanduser(path)) as f:
            return f.read().strip()
    if not sys.stdin.isatty():
        return sys.stdin.read().strip()
    import getpass
    return getpass.getpass("xAI API key (hidden): ").strip()


def cmd_brain(args):
    sub = args.pop(0) if args else "status"
    if sub == "status":
        b = need(bridge("brain", "0"))
        t, f = b.get("today") or {}, b.get("fresh") or {}
        print("Grok brain: %s%s" % ("on" if b.get("on") else "off", "" if b.get("hasKey") else " (no API key yet: coro brain key)"))
        if b.get("hasKey"):
            print("Key %s   model %s   today %d calls, $%.3f of $%.2f" % (b.get("hint"), b.get("model"), t.get("calls", 0), t.get("cost", 0), b.get("cap", 0)))
        made = time.strftime(", made %b %d %H:%M", time.localtime(f["at"] / 1000)) if f.get("at") else ""
        print("Fresh lines: %s, %d in use%s" % ("on" if f.get("on") else "off", f.get("count", 0), made))
        if b.get("notes"):
            print("Remembers: " + "  /  ".join(n.get("text", "") for n in b["notes"]))
        if b.get("busy"):
            print("Thinking about something right now.")
        if b.get("error"):
            print("Last problem: " + b["error"])
    elif sub == "key":
        key = read_key(opt(args, "--file"))
        if not KEY_RE.match(key):
            raise CoroError("that doesn't look like an xAI API key (they start with xai-)")
        try:
            r = need(bridge("brain-key", retries=3, stdin=True, key=key))
        except CoroError as e:
            raise CoroError(str(e).replace(key, "<key>").replace(b64(key), "<key>"))
        print("Saved on the Thor, encrypted: %s. He'll say hello in a moment." % r.get("hint"))
    elif sub == "forget-key":
        need(bridge("brain-key", "clear"))
        print("Key removed from the Thor. He's back to his built-in lines.")
    elif sub == "ask":
        text = " ".join(args).strip()
        if not text:
            raise CoroError('usage: coro brain ask "TEXT"')
        brain_line(need(bridge("brain-ask", text, retries=1)))
    elif sub in ("on", "off"):
        need(bridge("setting", "brain", value="true" if sub == "on" else "false"))
        print("Grok brain " + sub)
    elif sub == "cap":
        if not args:
            raise CoroError("usage: coro brain cap USD (a daily limit, 0.1 to 50)")
        r = need(bridge("setting", "brainCap", value=args[0].lstrip("$")))
        print("Daily limit: $%.2f" % r["brainCap"])
    elif sub == "model":
        if not args:
            raise CoroError("usage: coro brain model smartest|fastest|grok-4.3")
        name = BRAIN_MODELS.get(args[0].lower(), args[0])
        need(bridge("setting", "brainModel", value=name))
        print("Brain model: " + name)
    elif sub == "lines":
        r = need(bridge("brain-lines", args[0] if args else None))
        if args and args[0] == "refresh":
            print("Writing a new batch; it takes about two minutes." if r.get("started") else "Not now: already writing, brain off, or over the daily limit.")
        elif args and args[0] == "show":
            for k, lines in sorted((r.get("lines") or {}).get("lines", {}).items()):
                print("%s:" % k)
                for l in lines:
                    print("    " + l)
        else:
            f = r.get("fresh") or {}
            print("%d fresh lines in use%s" % (f.get("count", 0), time.strftime(", made %b %d %H:%M", time.localtime(f["at"] / 1000)) if f.get("at") else ""))
    elif sub == "chat":
        for m in need(bridge("brain", args[0] if args else "10")).get("chat", []):
            brain_line(m)
    elif sub == "clear":
        need(bridge("brain-clear", args[0] if args else "chat"))
        print("Cleared " + (args[0] if args else "the chat"))
    elif sub in ("yes", "no"):
        chat = need(bridge("brain", "60")).get("chat", [])
        asked = [(m["id"], a["id"]) for m in chat for a in m.get("actions") or [] if a.get("state") == "asked"]
        if args:
            msg, _, act = args[0].rpartition(":")
            asked = [x for x in asked if x[1] == act and (not msg or x[0] == msg)]
        if not asked:
            raise CoroError("no button is waiting for an answer")
        msg, act = asked[-1]
        a = need(bridge("brain-action", act, msg=msg, yes=sub == "yes"))["action"]
        print("%s: %s" % (a.get("label"), a.get("state")))
    else:
        raise CoroError("unknown brain command %s (try coro help)" % sub)


VOICE_DIR = "/sdcard/Coronamon/voice"


def voice_report(v):
    last = v.get("last") or {}
    print("Voice chat: %s   voice %s at %.2fx   keep listening %s   mic %s   now %s" % (
        "on" if v.get("on") else "off", v.get("voice"), v.get("speed", 1), "on" if v.get("followUp") else "off",
        "allowed" if v.get("mic") else "not allowed yet", v.get("state")))
    if last.get("heard") is not None:
        print("Heard: %s" % (last["heard"] or "(nothing)"))
    if last.get("reply"):
        print("Said: %s" % last["reply"])
    steps = [("speech-to-text ready", "sttReadyMs"), ("listening", "listenMs"), ("brain", "thinkMs"),
             ("first sound", "ttsFirstAudioMs"), ("talking", "speakMs")]
    times = ["%s %.1fs" % (name, last[k] / 1000.0) for name, k in steps if last.get(k)]
    if times:
        print("Took: " + ", ".join(times))
    extra = []
    if last.get("audioSec"):
        extra.append("%.1fs of audio heard, loudest %.2f%s" % (last["audioSec"], last.get("peak", 0), ", mic muted by Android" if last.get("silenced") else ""))
    if last.get("audioFrames"):
        extra.append("%d chars spoken as %.1fs at %d Hz" % (last.get("ttsChars", 0), last["audioFrames"] / float(last.get("sampleRate") or 24000), last.get("sampleRate", 0)))
    if extra:
        print("Audio: " + "; ".join(extra))
    if last.get("ttsError"):
        print("Voice problem: " + last["ttsError"])
    if v.get("error"):
        print("Last problem: " + v["error"])


def voice_wait(timeout=120):
    end = time.time() + timeout
    while time.time() < end:
        v = need(bridge("voice", "status"))
        if v.get("state") == "idle":
            return v
        time.sleep(0.5)
    raise CoroError("he's still busy after %d seconds" % timeout)


def cmd_voice(args):
    sub = args.pop(0) if args else "status"
    if sub == "status":
        voice_report(need(bridge("voice", "status")))
    elif sub == "listen":
        need(bridge("voice", "listen"))
        print("He's listening. Talk to the Thor, or run coro voice stop.")
    elif sub == "stop":
        need(bridge("voice", "stop"))
        print("Stopped.")
    elif sub == "sample":
        need(bridge("voice", "sample"))
        voice_report(voice_wait())
    elif sub == "say":
        pull = opt(args, "--pull")
        text = " ".join(args).strip()
        if not text:
            raise CoroError('usage: coro voice say "TEXT" [--pull DIR]')
        need(bridge("voice", "say", text=text))
        voice_report(voice_wait())
        if pull:
            os.makedirs(os.path.expanduser(pull), exist_ok=True)
            dest = os.path.join(os.path.expanduser(pull), "coronamon-voice-%s.wav" % time.strftime("%H%M%S"))
            adb("pull", VOICE_DIR + "/last.wav", dest)
            print(dest)
    elif sub == "hear":
        reply = flag(args, "--reply")
        if not args:
            raise CoroError("usage: coro voice hear FILE.wav [--reply]")
        path = args[0]
        if os.path.isfile(os.path.expanduser(path)):
            remote = VOICE_DIR + "/test.wav"
            sh("mkdir -p " + VOICE_DIR)
            adb("push", os.path.expanduser(path), remote)
            path = remote
        voice_report(need(bridge("voice-hear", path, retries=1, reply=reply)))
    elif sub == "voices":
        r = need(bridge("voice-voices"))
        voices = r.get("voices")
        for v in voices if isinstance(voices, list) else [voices]:
            if isinstance(v, dict):
                name = v.get("voice_id") or v.get("id") or v.get("name")
                rest = {k: x for k, x in v.items() if k not in ("voice_id", "id")}
                print("%-8s %s" % (name, json.dumps(rest, ensure_ascii=False)))
            else:
                print(v)
    elif sub == "use":
        if not args:
            raise CoroError("usage: coro voice use VOICE (kepler, sal, naksh, helix, rex... coro voice voices lists them all)")
        r = need(bridge("setting", "voiceId", value=args[0]))
        print("His voice: " + r["voiceId"])
    elif sub == "speed":
        if not args:
            raise CoroError("usage: coro voice speed 0.7-1.5")
        r = need(bridge("setting", "voiceSpeed", value=args[0]))
        print("Voice speed: %.2fx" % r["voiceSpeed"])
    elif sub in ("on", "off"):
        need(bridge("setting", "voice", value="true" if sub == "on" else "false"))
        print("Voice chat " + sub)
    else:
        raise CoroError("unknown voice command %s (try coro help)" % sub)


