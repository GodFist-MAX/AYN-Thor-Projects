#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;
struct Payload { uint magic; };
taskPayloadSharedEXT Payload payload;
layout(location = 0) out vec4 vcolor[];
void main() {
    uint w = gl_WorkGroupID.x;
    float cx = w == 0u ? -0.5 : 0.5;
    vec4 c = payload.magic != 7u ? vec4(1.0) : (w == 0u ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(0.0, 0.0, 1.0, 1.0));
    SetMeshOutputsEXT(3, 1);
    gl_MeshVerticesEXT[0].gl_Position = vec4(cx - 0.4, -0.5, 0.0, 1.0);
    gl_MeshVerticesEXT[1].gl_Position = vec4(cx + 0.4, -0.5, 0.0, 1.0);
    gl_MeshVerticesEXT[2].gl_Position = vec4(cx, 0.5, 0.0, 1.0);
    vcolor[0] = vcolor[1] = vcolor[2] = c;
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
}
